[Unit]
Description=Telegram task watcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/tg-task-alert
ExecStart=/home/ubuntu/tg-task-alert/venv/bin/python -u watch_tasks.py
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
